---
const navItems = [
  { label: 'About', href: '/about/' },
  { label: 'Services', href: '/services/' },
  { label: 'Industries', href: '/industries/' },
  { label: 'Leadership', href: '/leadership/' },
  { label: 'Contact', href: '/contact/' },
];

const certifications = [
  'ISO 27001:2022',
  'HIPAA',
  'SSAE18 SOC 2',
  'PCI-DSS',
  'ISAE 3402',
];

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <!-- Company info -->
      <div class="footer__col">
        <div class="footer__logo">
          <svg width="150" height="28" viewBox="0 0 205 38" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M7 1 Q1 10, 7 19 Q13 28, 7 37" stroke="#D4552A" stroke-width="2.2" fill="none" stroke-linecap="round"/>
            <text x="15" y="20" font-family="Inter, sans-serif" font-size="18" font-weight="700" letter-spacing="1.2">
              <tspan fill="#FFFFFF">SOURCE</tspan><tspan dx="4"> </tspan><tspan fill="#D4552A">HUB</tspan>
            </text>
          </svg>
        </div>
        <p class="footer__tagline">One click convenience to outsourcing</p>
        <p class="footer__legal-name">Source Hub India Pvt Ltd</p>
      </div>

      <!-- Navigation -->
      <div class="footer__col">
        <h3 class="footer__heading">Company</h3>
        <ul class="footer__nav">
          {navItems.map(item => (
            <li><a href={item.href} class="footer__link">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div class="footer__col">
        <h3 class="footer__heading">Contact</h3>
        <ul class="footer__contact-list">
          <li>
            <a href="mailto:info@sourcehubindia.com" class="footer__link">info@sourcehubindia.com</a>
          </li>
          <li>
            <a href="mailto:projects@sourcehubindia.com" class="footer__link">projects@sourcehubindia.com</a>
          </li>
          <li class="footer__phone">
            <span class="footer__phone-label">India</span>
            <a href="tel:+918041138190" class="footer__link">+91-80-4113 8190</a>
          </li>
          <li class="footer__phone">
            <span class="footer__phone-label">USA</span>
            <a href="tel:+17135181477" class="footer__link">+1 713-518-1477</a>
          </li>
        </ul>
      </div>

      <!-- Certifications -->
      <div class="footer__col">
        <h3 class="footer__heading">Certifications</h3>
        <ul class="footer__cert-list">
          {certifications.map(cert => (
            <li class="footer__cert">{cert}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; {currentYear} Source Hub India Pvt Ltd. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-bg-dark);
    color: #B0BEC5;
    padding: var(--space-16) 0 var(--space-8);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .footer__grid > * {
    min-width: 0;
  }

  .footer__logo {
    margin-bottom: var(--space-4);
  }

  .footer__tagline {
    font-size: var(--text-sm);
    color: #78909C;
    margin-bottom: var(--space-2);
    font-style: italic;
  }

  .footer__legal-name {
    font-size: var(--text-sm);
    font-weight: 600;
    color: #B0BEC5;
    margin-bottom: var(--space-1);
  }

  .footer__heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #78909C;
    margin-bottom: var(--space-4);
  }

  .footer__nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer__link {
    font-size: var(--text-sm);
    color: #B0BEC5;
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer__link:hover {
    color: var(--color-text-inverse);
  }

  .footer__contact-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer__phone {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  .footer__phone-label {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #78909C;
    min-width: 32px;
  }

  .footer__cert-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer__cert {
    font-size: var(--text-sm);
    color: #B0BEC5;
  }

  .footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: var(--space-6);
    font-size: var(--text-xs);
    color: #546E7A;
  }

  @media (max-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
