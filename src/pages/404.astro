---
import BaseLayout from '../layouts/BaseLayout.astro';

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
  { label: 'Services', href: '/services/' },
  { label: 'Industries', href: '/industries/' },
  { label: 'Leadership', href: '/leadership/' },
  { label: 'Contact', href: '/contact/' },
];
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist. Navigate to another section of the Source Hub India website or contact us for help."
  canonicalPath="/404"
>
  <section class="not-found">
    <div class="container not-found__inner">
      <p class="not-found__code">404</p>
      <h1 class="not-found__title">Page not found</h1>
      <p class="not-found__desc">
        The page you're looking for doesn't exist or has been moved.
      </p>

      <nav class="not-found__nav" aria-label="Site navigation">
        <h2 class="not-found__nav-heading">Where would you like to go?</h2>
        <ul class="not-found__nav-list">
          {navLinks.map(link => (
            <li><a href={link.href} class="not-found__nav-link">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="not-found__contact">
        <p>Need help? Reach us at <a href="mailto:info@sourcehubindia.com">info@sourcehubindia.com</a> or call <a href="tel:+918041138190">+91-80-4113 8190</a></p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    background-color: var(--color-bg-dark);
    min-height: calc(100vh - var(--header-height) - 200px);
    display: flex;
    align-items: center;
    padding: var(--space-16) 0;
  }

  .not-found__inner {
    max-width: 600px;
  }

  .not-found__code {
    font-family: var(--font-heading);
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.08);
    line-height: 1;
    margin-bottom: var(--space-2);
  }

  .not-found__title {
    font-size: var(--text-3xl);
    color: var(--color-text-inverse);
    margin-bottom: var(--space-4);
  }

  .not-found__desc {
    font-size: var(--text-base);
    color: #78909C;
    margin-bottom: var(--space-10);
  }

  .not-found__nav-heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #546E7A;
    margin-bottom: var(--space-4);
  }

  .not-found__nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-10);
  }

  .not-found__nav-link {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: 500;
    color: #B0BEC5;
    padding: var(--space-2) var(--space-4);
    border: 1px solid rgba(255, 255, 255, 0.15);
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }

  .not-found__nav-link:hover {
    color: var(--color-text-inverse);
    border-color: var(--color-warm);
  }

  .not-found__contact {
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .not-found__contact p {
    font-size: var(--text-sm);
    color: #78909C;
  }

  .not-found__contact a {
    color: #B0BEC5;
    text-decoration: none;
    transition: color 0.2s;
  }

  .not-found__contact a:hover {
    color: var(--color-text-inverse);
  }
</style>
