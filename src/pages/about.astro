---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatBar from '../components/StatBar.astro';
import CTABanner from '../components/CTABanner.astro';

const stats = [
  { value: '20+', label: 'Years of Service' },
  { value: '600+', label: 'Employees' },
  { value: '16,250+', label: 'Projects Completed' },
  { value: '1B+', label: 'Pages Processed' },
];

const certifications = [
  {
    name: 'ISO 27001:2022',
    issuer: 'BSI Certification',
    description: 'International standard for information security management systems. Demonstrates systematic protection of sensitive company and client data.',
  },
  {
    name: 'HIPAA Title II',
    issuer: 'Security Rules Compliance',
    description: 'Compliance with US healthcare data protection requirements. Essential for handling protected health information in medical and insurance document processing.',
  },
  {
    name: 'SSAE18 Type-2 SOC 2',
    issuer: 'Service Organization Control',
    description: 'Independent audit of security, availability, processing integrity, and confidentiality controls. The gold standard for US-based service providers.',
  },
  {
    name: 'PCI-DSS',
    issuer: 'Payment Card Industry',
    description: 'Data security standard for organizations that handle payment card information. Ensures secure processing of financial documents.',
  },
  {
    name: 'ISAE 3402',
    issuer: 'International Assurance Standard',
    description: 'International equivalent of SOC reports, providing assurance on controls at service organizations for global clients.',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Source Hub India",
  "url": "https://sourcehubindia.com/about/",
  "mainEntity": { "@id": "https://sourcehubindia.com/#organization" },
};
---

<BaseLayout
  title="About"
  description="About Source Hub India — ISO 27001 and HIPAA certified legal document management company. 600+ employees, 3 offices."
  canonicalPath="/about/"
  schema={schema}
>
  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <h1 class="page-header__title">About Source Hub</h1>
      <p class="page-header__subtitle">
        A global outsourcing solutions provider headquartered in Bangalore, India — the Silicon Valley of India.
      </p>
    </div>
  </section>

  <!-- Company Overview -->
  <section class="section">
    <div class="container">
      <div class="about-grid">
        <div class="about-content">
          <div class="section-heading">
            <h2 class="section-heading__title">Our Story</h2>
          </div>
          <p>
            Source Hub India Pvt Ltd has been the preferred business partner for US-based service bureaus
            in litigation support services for over 20 years. We bring enterprise-scale capabilities
            to every engagement.
          </p>
          <p>
            Our core expertise spans legal document management, document review, legal research,
            contract management, electronic data discovery, forms processing, and data conversion services.
            We serve Fortune 500 companies across six critical industries, delivering consistently with
            99.95% accuracy and 99.99% on-time delivery.
          </p>
          <p>
            With over 600 professionals across three delivery centers in India and US-timezone support,
            we offer the scale, security, and reliability that enterprise clients require.
          </p>
        </div>
        <div class="about-sidebar">
          <div class="about-sidebar__card">
            <h3 class="about-sidebar__heading">Our Vision</h3>
            <p class="about-sidebar__text">
              Being a leader and trusted business partner in data management solutions and
              services across the globe.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <StatBar stats={stats} />

  <!-- Certifications -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-heading">
        <h2 class="section-heading__title">Certifications & Compliance</h2>
        <p class="section-heading__subtitle">
          We maintain the industry's most rigorous security and compliance certifications,
          ensuring your data is protected to the highest standards.
        </p>
      </div>
      <div class="cert-grid">
        {certifications.map(cert => (
          <div class="cert-card">
            <div class="cert-card__badge">{cert.name}</div>
            <p class="cert-card__issuer">{cert.issuer}</p>
            <p class="cert-card__desc">{cert.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Infrastructure -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <h2 class="section-heading__title">Infrastructure & Quality</h2>
      </div>
      <div class="grid grid--3">
        <div class="infra-card">
          <h3 class="infra-card__title">Delivery Centers</h3>
          <p class="infra-card__text">
            Three offices across India — Bangalore (headquarters), Udupi, and Mysuru — providing
            geographic redundancy and access to diverse talent pools.
          </p>
        </div>
        <div class="infra-card">
          <h3 class="infra-card__title">Data Center Facilities</h3>
          <p class="infra-card__text">
            State-of-the-art infrastructure with redundant internet connectivity, power backup,
            and geographically isolated replica facilities. Hybrid coding solutions collocated
            at 365 Data Centres.
          </p>
        </div>
        <div class="infra-card">
          <h3 class="infra-card__title">Quality Commitment</h3>
          <p class="infra-card__text">
            We deliver with 99.95% accuracy and 99.99% on-time delivery across all service lines.
            Rigorous quality control processes are embedded at every stage of document processing.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CTABanner
    heading="Want to learn more about our capabilities?"
    description="Our team is ready to discuss how Source Hub can support your document management needs."
  />
</BaseLayout>

<style>
  .page-header {
    background-color: var(--color-bg-dark);
    padding: clamp(2.5rem, 6vw, 4rem) 0;
  }

  .page-header__title {
    font-size: var(--text-4xl);
    color: var(--color-text-inverse);
    margin-bottom: var(--space-4);
  }

  .page-header__subtitle {
    font-size: var(--text-lg);
    color: #B0BEC5;
    max-width: 600px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-12);
  }

  .about-content p {
    color: var(--color-text-light);
    margin-bottom: var(--space-4);
    line-height: 1.7;
  }

  .about-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .about-sidebar__card {
    padding: var(--space-6);
    background-color: var(--color-bg-alt);
    border-left: 3px solid var(--color-warm);
  }

  .about-sidebar__heading {
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
  }

  .about-sidebar__text {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: 1.6;
  }

  /* Certifications */
  .cert-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .cert-card {
    padding: var(--space-6);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
  }

  .cert-card__badge {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    padding: var(--space-1) var(--space-3);
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    display: inline-block;
    margin-bottom: var(--space-3);
  }

  .cert-card__issuer {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-light);
    margin-bottom: var(--space-3);
  }

  .cert-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: 1.6;
  }

  /* Infrastructure */
  .infra-card {
    padding: var(--space-6);
  }

  .infra-card__title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .infra-card__text {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .cert-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .cert-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
