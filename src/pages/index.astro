---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatBar from '../components/StatBar.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CTABanner from '../components/CTABanner.astro';

const stats = [
  { value: '16,250+', label: 'Legal Projects' },
  { value: '1B+', label: 'Pages Processed' },
  { value: '250M+', label: 'Documents Handled' },
  { value: '2B+', label: 'Fields Coded' },
];

const services = [
  {
    title: 'Legal Coding & Document Management',
    description: 'Objective, subjective, and in-text coding. Document unitization, Bates capture, redaction, OCR, and quality control.',
    href: '/services/#legal-coding',
  },
  {
    title: 'Document Review',
    description: 'Comprehensive review services for litigation, regulatory compliance, and internal investigations across all document types.',
    href: '/services/#document-review',
  },
  {
    title: 'Contracts Management',
    description: 'End-to-end contract lifecycle support including abstraction, repository management, and compliance tracking.',
    href: '/services/#contracts-management',
  },
  {
    title: 'Legal Research',
    description: 'Thorough legal research services supporting case preparation, regulatory analysis, and due diligence processes.',
    href: '/services/#legal-research',
  },
  {
    title: 'Electronic Data Discovery',
    description: 'EDD processing, image quality control, and data conversion services supporting complex litigation workflows.',
    href: '/services/#edd',
  },
  {
    title: 'Transcription Services',
    description: 'Medical, legal, and general transcription with rigorous quality standards and rapid turnaround times.',
    href: '/services/#transcription',
  },
];

const certifications = [
  'ISO 27001:2022',
  'HIPAA',
  'SSAE18 SOC 2',
  'PCI-DSS',
  'ISAE 3402',
];

const industries = [
  { name: 'Oil & Energy', id: 'oil-energy', icon: '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C12 2 4 8 4 14a8 8 0 0016 0c0-6-8-12-8-12z"/></svg>' },
  { name: 'Financial Services', id: 'financial-services', icon: '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20h20M5 20V10l7-7 7 7v10M9 20v-4h6v4"/></svg>' },
  { name: 'Healthcare', id: 'healthcare', icon: '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/><rect x="3" y="3" width="18" height="18" rx="2"/></svg>' },
  { name: 'Telecom', id: 'telecom', icon: '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V10M18 20V4M6 20v-4M2 20h20"/></svg>' },
  { name: 'Automobile', id: 'automobile', icon: '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17h14M5 17a2 2 0 01-2-2V9l3-4h12l3 4v6a2 2 0 01-2 2M7 17a2 2 0 100 4 2 2 0 000-4zM17 17a2 2 0 100 4 2 2 0 000-4z"/></svg>' },
  { name: 'Airline', id: 'airline', icon: '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 00-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>' },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://sourcehubindia.com/#organization",
      "name": "Source Hub India Pvt Ltd",
      "alternateName": "Source Hub",
      "url": "https://sourcehubindia.com",
      "logo": {
        "@type": "ImageObject",
        "url": "https://sourcehubindia.com/images/og-image.png",
        "width": 1200,
        "height": 630,
      },
      "image": "https://sourcehubindia.com/images/og-image.png",
      "description": "Legal document management, litigation support, and legal coding services for Fortune 500 companies. ISO 27001, HIPAA, SOC 2, PCI-DSS, ISAE 3402 certified.",
      "foundingDate": "2004",
      "numberOfEmployees": { "@type": "QuantitativeValue", "minValue": 600 },
      "knowsAbout": [
        "Legal Document Management",
        "Legal Coding",
        "Document Review",
        "Contracts Management",
        "Legal Research",
        "Electronic Data Discovery",
        "Litigation Support",
        "Transcription Services",
      ],
      "hasCredential": [
        { "@type": "EducationalOccupationalCredential", "credentialCategory": "certification", "name": "ISO 27001:2022" },
        { "@type": "EducationalOccupationalCredential", "credentialCategory": "certification", "name": "HIPAA Title II" },
        { "@type": "EducationalOccupationalCredential", "credentialCategory": "certification", "name": "SSAE18 Type-2 SOC 2" },
        { "@type": "EducationalOccupationalCredential", "credentialCategory": "certification", "name": "PCI-DSS" },
        { "@type": "EducationalOccupationalCredential", "credentialCategory": "certification", "name": "ISAE 3402" },
      ],
      "address": [
        {
          "@type": "PostalAddress",
          "streetAddress": "#29, Shree Krishna, 3rd Floor, Magadi Main Road, Govindraj Nagar",
          "addressLocality": "Bangalore",
          "addressRegion": "Karnataka",
          "postalCode": "560040",
          "addressCountry": "IN",
        },
        {
          "@type": "PostalAddress",
          "streetAddress": "Sri Laxmi Narasimha Tower, 1st & 2nd Floor, Kunjibettu",
          "addressLocality": "Udupi",
          "addressRegion": "Karnataka",
          "postalCode": "576102",
          "addressCountry": "IN",
        },
        {
          "@type": "PostalAddress",
          "streetAddress": "#11, 2nd Floor, Udayaravi Road, 1st Stage Kuvempunagar",
          "addressLocality": "Mysuru",
          "addressRegion": "Karnataka",
          "postalCode": "570023",
          "addressCountry": "IN",
        },
      ],
      "contactPoint": [
        { "@type": "ContactPoint", "telephone": "+91-80-4113-8190", "contactType": "customer service", "areaServed": "IN", "availableLanguage": "English" },
        { "@type": "ContactPoint", "telephone": "+1-713-518-1477", "contactType": "customer service", "areaServed": "US", "availableLanguage": "English" },
      ],
      "email": "info@sourcehubindia.com",
      "areaServed": ["US", "IN", "GB"],
    },
    {
      "@type": "WebSite",
      "@id": "https://sourcehubindia.com/#website",
      "url": "https://sourcehubindia.com",
      "name": "Source Hub India",
      "publisher": { "@id": "https://sourcehubindia.com/#organization" },
    },
  ],
};
---

<BaseLayout
  title="Trusted Legal Document Partner for Fortune 500 Companies"
  description="Source Hub India — 20+ years of legal coding, document management, and litigation support for Fortune 500 companies. ISO 27001, HIPAA, SOC 2 certified."
  canonicalPath="/"
  schema={schema}
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <h1 class="hero__title">Trusted Legal Document Partner<br />for Fortune 500 Companies</h1>
      <p class="hero__subtitle">
        20+ years of litigation support, document management, and legal coding services.
      </p>
      <div class="hero__actions">
        <a href="/services/" class="btn btn--primary">Explore Our Services</a>
        <a href="/contact/" class="btn btn--outline">Contact Us</a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <StatBar stats={stats} />

  <!-- Services -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <h2 class="section-heading__title">Comprehensive Legal Support Services</h2>
        <p class="section-heading__subtitle">
          From document coding to litigation support, we deliver end-to-end legal process services with 99.95% accuracy.
        </p>
      </div>
      <div class="grid grid--3">
        {services.map(service => (
          <ServiceCard
            title={service.title}
            description={service.description}
            href={service.href}
          />
        ))}
      </div>
      <div class="services-cta">
        <a href="/services/" class="btn btn--outline-dark">View All Services</a>
      </div>
    </div>
  </section>

  <!-- Why Source Hub -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-heading">
        <h2 class="section-heading__title">Why Leading Organizations Choose Source Hub</h2>
      </div>
      <div class="grid grid--3">
        <div class="why-card">
          <h3 class="why-card__title">20+ Years of Excellence</h3>
          <p class="why-card__text">
            Preferred business partner for US-based service bureaus in litigation support services.
            Over two decades of consistent, reliable delivery for the world's most demanding clients.
          </p>
          <ul class="why-card__list">
            <li>16,250+ legal coding projects completed</li>
            <li>1 billion+ pages processed</li>
            <li>600+ skilled professionals</li>
          </ul>
        </div>
        <div class="why-card">
          <h3 class="why-card__title">Enterprise-Grade Security</h3>
          <p class="why-card__text">
            Your data security is non-negotiable. We maintain the industry's most rigorous compliance certifications.
          </p>
          <ul class="why-card__cert-list">
            {certifications.map(cert => (
              <li class="why-card__cert">{cert}</li>
            ))}
          </ul>
        </div>
        <div class="why-card">
          <h3 class="why-card__title">Scalable Operations</h3>
          <p class="why-card__text">
            Three delivery centers across India with US-timezone coverage. State-of-the-art infrastructure
            with redundant connectivity and geographically isolated facilities.
          </p>
          <ul class="why-card__list">
            <li>Bangalore, Udupi, and Mysuru offices</li>
            <li>US phone support: +1 713-518-1477</li>
            <li>24/7 operational capability</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Industries -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <h2 class="section-heading__title">Serving Critical Industries</h2>
        <p class="section-heading__subtitle">
          Preferred coding service provider for Fortune 500 companies across six key industry verticals.
        </p>
      </div>
      <div class="industries-grid">
        {industries.map(industry => (
          <a href={`/industries/#${industry.id}`} class="industry-badge">
            <span class="industry-badge__icon" set:html={industry.icon} />
            <span class="industry-badge__name">{industry.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABanner
    heading="Ready to discuss your next project?"
    description="Get in touch to learn how Source Hub can support your document management needs."
  />


</BaseLayout>

<style>
  /* Hero */
  .hero {
    background-color: var(--color-bg-dark);
    /* fluid: 48 px on small phones → 96 px at 1200 px */
    padding: clamp(3rem, 8vw, 6rem) 0;
  }

  .hero__inner {
    max-width: var(--max-width);
  }

  .hero__title {
    /* direct clamp — do not reference var(--text-5xl) to avoid nested clamp */
    font-size: clamp(1.75rem, 6vw, 3rem);
    color: var(--color-text-inverse);
    margin-bottom: var(--space-6);
    line-height: 1.15;
  }

  .hero__subtitle {
    font-size: var(--text-lg);
    color: #B0BEC5;
    margin-bottom: var(--space-8);
    max-width: 560px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  /* Services CTA */
  .services-cta {
    text-align: center;
    margin-top: var(--space-10);
  }

  /* Why Cards */
  .why-card {
    padding: var(--space-6);
  }

  .why-card__title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .why-card__text {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    margin-bottom: var(--space-4);
  }

  .why-card__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .why-card__list li {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    padding-left: var(--space-4);
    position: relative;
  }

  .why-card__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 6px;
    height: 6px;
    background-color: var(--color-warm);
  }

  .why-card__cert-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .why-card__cert {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--space-1) var(--space-3);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-primary);
  }

  /* Industries */
  .industries-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-4);
  }

  .industry-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-4);
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .industry-badge:hover {
    border-color: var(--color-primary);
    background-color: var(--color-bg-alt);
  }

  .industry-badge__icon {
    color: var(--color-primary);
    line-height: 1;
  }

  .industry-badge__name {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text);
    text-align: center;
  }

  @media (max-width: 1024px) {
    .industries-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero__actions .btn {
      text-align: center;
    }

    .industries-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
