---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CTABanner from '../components/CTABanner.astro';

const SITE = Astro.site!.origin;

const stats = [
  { value: '16,250+', label: 'Legal Projects' },
  { value: '1B+', label: 'Pages Processed' },
  { value: '250M+', label: 'Documents Handled' },
  { value: '2B+', label: 'Fields Coded' },
];

const services = [
  {
    title: 'Legal Coding & Document Management',
    description: 'Objective, subjective, and in-text coding. Document unitization, Bates capture, redaction, OCR, and quality control.',
    href: '/services/#legal-coding',
  },
  {
    title: 'Document Review',
    description: 'Comprehensive review services for litigation, regulatory compliance, and internal investigations across all document types.',
    href: '/services/#document-review',
  },
  {
    title: 'Contracts Management',
    description: 'End-to-end contract lifecycle support including abstraction, repository management, and compliance tracking.',
    href: '/services/#contracts-management',
  },
  {
    title: 'Legal Research',
    description: 'Thorough legal research services supporting case preparation, regulatory analysis, and due diligence processes.',
    href: '/services/#legal-research',
  },
  {
    title: 'Electronic Data Discovery',
    description: 'EDD processing, image quality control, and data conversion services supporting complex litigation workflows.',
    href: '/services/#edd',
  },
  {
    title: 'Transcription Services',
    description: 'Medical, legal, and general transcription with rigorous quality standards and rapid turnaround times.',
    href: '/services/#transcription',
  },
];

const certifications = [
  'ISO 27001:2022',
  'HIPAA',
  'SSAE18 SOC 2',
  'PCI-DSS',
  'ISAE 3402',
];

const industries = [
  { name: 'Oil & Energy', id: 'oil-energy', icon: '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C12 2 4 8 4 14a8 8 0 0016 0c0-6-8-12-8-12z"/></svg>' },
  { name: 'Financial Services', id: 'financial-services', icon: '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20h20M5 20V10l7-7 7 7v10M9 20v-4h6v4"/></svg>' },
  { name: 'Healthcare', id: 'healthcare', icon: '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/><rect x="3" y="3" width="18" height="18" rx="2"/></svg>' },
  { name: 'Telecom', id: 'telecom', icon: '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V10M18 20V4M6 20v-4M2 20h20"/></svg>' },
  { name: 'Automobile', id: 'automobile', icon: '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17h14M5 17a2 2 0 01-2-2V9l3-4h12l3 4v6a2 2 0 01-2 2M7 17a2 2 0 100 4 2 2 0 000-4zM17 17a2 2 0 100 4 2 2 0 000-4z"/></svg>' },
  { name: 'Airline', id: 'airline', icon: '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 00-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>' },
  { name: 'Professional Sports', id: 'professional-sports', icon: '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a15 15 0 014 10 15 15 0 01-4 10 15 15 0 01-4-10 15 15 0 014-10z"/><path d="M2 12h20"/></svg>' },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE}/#organization`,
      "name": "Source Hub India Pvt Ltd",
      "alternateName": "Source Hub",
      "url": SITE,
      "logo": {
        "@type": "ImageObject",
        "url": `${SITE}/images/og/default.png`,
        "width": 1200,
        "height": 630,
      },
      "image": `${SITE}/images/og/default.png`,
      "description": "Legal document management, litigation support, and legal coding services for Fortune 500 companies. ISO 27001, HIPAA, SOC 2, PCI-DSS, ISAE 3402 certified.",
      "foundingDate": "2004",
      "numberOfEmployees": { "@type": "QuantitativeValue", "minValue": 600 },
      "knowsAbout": [
        "Legal Document Management",
        "Legal Coding",
        "Document Review",
        "Contracts Management",
        "Legal Research",
        "Electronic Data Discovery",
        "Litigation Support",
        "Transcription Services",
      ],
      "hasCredential": [
        { "@type": "EducationalOccupationalCredential", "credentialCategory": "certification", "name": "ISO 27001:2022" },
        { "@type": "EducationalOccupationalCredential", "credentialCategory": "certification", "name": "HIPAA Title II" },
        { "@type": "EducationalOccupationalCredential", "credentialCategory": "certification", "name": "SSAE18 Type-2 SOC 2" },
        { "@type": "EducationalOccupationalCredential", "credentialCategory": "certification", "name": "PCI-DSS" },
        { "@type": "EducationalOccupationalCredential", "credentialCategory": "certification", "name": "ISAE 3402" },
      ],
      "address": [
        {
          "@type": "PostalAddress",
          "streetAddress": "#29, Shree Krishna, 3rd Floor, Magadi Main Road, Govindraj Nagar",
          "addressLocality": "Bengaluru",
          "addressRegion": "Karnataka",
          "postalCode": "560040",
          "addressCountry": "IN",
        },
        {
          "@type": "PostalAddress",
          "streetAddress": "Sri Laxmi Narasimha Tower, 1st & 2nd Floor, Kunjibettu",
          "addressLocality": "Udupi",
          "addressRegion": "Karnataka",
          "postalCode": "576102",
          "addressCountry": "IN",
        },
        {
          "@type": "PostalAddress",
          "streetAddress": "#11, 2nd Floor, Udayaravi Road, 1st Stage Kuvempunagar",
          "addressLocality": "Mysuru",
          "addressRegion": "Karnataka",
          "postalCode": "570023",
          "addressCountry": "IN",
        },
      ],
      "contactPoint": [
        { "@type": "ContactPoint", "telephone": "+91-80-4113-8190", "contactType": "customer service", "areaServed": "IN", "availableLanguage": "English" },
        { "@type": "ContactPoint", "telephone": "+1-713-518-1477", "contactType": "customer service", "areaServed": "US", "availableLanguage": "English" },
      ],
      "email": "info@sourcehubindia.com",
      "areaServed": ["US", "IN", "GB"],
    },
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      "url": SITE,
      "name": "Source Hub India",
      "publisher": { "@id": `${SITE}/#organization` },
    },
  ],
};
---

<BaseLayout
  title="Trusted Legal Document Partner for Fortune 500 Companies"
  description="Source Hub India — 20+ years of legal coding, document management, and litigation support for Fortune 500 companies. ISO 27001, HIPAA, SOC 2 certified."
  canonicalPath="/"
  schema={schema}
>
  <!-- Hero -->
  <section class="hero">
    <!-- Watermark S-curve -->
    <svg class="hero__watermark" viewBox="0 0 200 600" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M100 20 Q20 150, 100 300 Q180 450, 100 580" stroke="rgba(255,255,255,0.04)" stroke-width="60" fill="none" stroke-linecap="round"/>
    </svg>

    <div class="container hero__inner">
      <h1 class="hero__title anim-fade-up anim-delay-1">Trusted Legal Document Partner<br class="hero__br" />for Fortune 500 Companies</h1>
      <p class="hero__subtitle anim-fade-up anim-delay-2">
        20+ years of litigation support, document management, and legal coding services.
      </p>
      <div class="hero__actions anim-fade-up anim-delay-3">
        <a href="/services/" class="btn btn--primary">Explore Our Services</a>
        <a href="/contact/" class="btn btn--outline">Contact Us</a>
      </div>

      <div class="hero__divider"></div>

      <div class="hero__stats">
        {stats.map((stat, i) => (
          <div class={`hero__stat anim-fade-up anim-delay-stat-${i + 1}`}>
            <div class="hero__stat-value">{stat.value}</div>
            <div class="hero__stat-label">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <h2 class="section-heading__title">Comprehensive Legal Support Services</h2>
        <p class="section-heading__subtitle">
          From document coding to litigation support, we deliver end-to-end legal process services with 99.95% accuracy.
        </p>
      </div>
      <div class="grid grid--3">
        {services.map(service => (
          <ServiceCard
            title={service.title}
            description={service.description}
            href={service.href}
          />
        ))}
      </div>
      <div class="services-cta">
        <a href="/services/" class="btn btn--outline-dark">View All Services</a>
      </div>
    </div>
  </section>

  <!-- Why Source Hub -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-heading">
        <h2 class="section-heading__title">Why Leading Organizations Choose Source Hub</h2>
      </div>
      <div class="grid grid--3">
        <div class="why-card">
          <h3 class="why-card__title">20+ Years of Excellence</h3>
          <p class="why-card__text">
            Preferred business partner for US-based service bureaus in litigation support services.
            Over two decades of consistent, reliable delivery for the world's most demanding clients.
          </p>
          <ul class="why-card__list">
            <li>16,250+ legal coding projects completed</li>
            <li>1 billion+ pages processed</li>
            <li>600+ skilled professionals</li>
          </ul>
        </div>
        <div class="why-card">
          <h3 class="why-card__title">Enterprise-Grade Security</h3>
          <p class="why-card__text">
            Your data security is non-negotiable. We maintain the industry's most rigorous compliance certifications.
          </p>
          <ul class="why-card__cert-list">
            {certifications.map(cert => (
              <li class="why-card__cert">{cert}</li>
            ))}
          </ul>
        </div>
        <div class="why-card">
          <h3 class="why-card__title">Scalable Operations</h3>
          <p class="why-card__text">
            Three delivery centers across India with US-timezone coverage. State-of-the-art infrastructure
            with redundant connectivity and geographically isolated facilities.
          </p>
          <ul class="why-card__list">
            <li>Bengaluru, Udupi, and Mysuru offices</li>
            <li>US phone support: +1 713-518-1477</li>
            <li>24/7 operational capability</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Carousel -->
  <section class="section section--dark testimonials-carousel">
    <div class="container">
      <div class="section-heading section-heading--light">
        <h2 class="section-heading__title">What Our Clients Say</h2>
      </div>
      <div class="carousel" id="testimonialCarousel">
        <blockquote class="carousel__quote">
          <p class="carousel__text" id="carouselText"></p>
          <footer>
            <cite class="carousel__cite" id="carouselCite"></cite>
          </footer>
        </blockquote>
        <div class="carousel__dots" id="carouselDots" role="tablist" aria-label="Testimonial navigation"></div>
      </div>
      <div class="carousel__cta">
        <a href="/testimonials/" class="btn btn--outline">Read All Testimonials</a>
      </div>
    </div>
  </section>

  <!-- Industries -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <h2 class="section-heading__title">Serving Critical Industries</h2>
        <p class="section-heading__subtitle">
          Preferred coding service provider for Fortune 500 companies across seven key industry verticals.
        </p>
      </div>
      <div class="industries-grid">
        {industries.map(industry => (
          <a href={`/industries/#${industry.id}`} class="industry-badge">
            <span class="industry-badge__icon" set:html={industry.icon} />
            <span class="industry-badge__name">{industry.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTABanner
    heading="Ready to discuss your next project?"
    description="Get in touch to learn how Source Hub can support your document management needs."
  />


</BaseLayout>

<style>
  /* Hero */
  .hero {
    background: linear-gradient(135deg, #0F2440 0%, #152E4A 50%, #0F2440 100%);
    padding: clamp(3rem, 8vw, 5rem) 0 clamp(2.5rem, 6vw, 4rem);
    position: relative;
    overflow: hidden;
  }

  .hero__watermark {
    position: absolute;
    right: -40px;
    top: 50%;
    transform: translateY(-50%);
    width: 300px;
    height: auto;
    pointer-events: none;
  }

  .hero__inner {
    max-width: var(--max-width);
    position: relative;
    z-index: 1;
  }

  .hero__title {
    font-size: clamp(1.75rem, 6vw, 3rem);
    color: var(--color-text-inverse);
    margin-bottom: var(--space-6);
    line-height: 1.15;
  }

  .hero__subtitle {
    font-size: var(--text-lg);
    color: #B0BEC5;
    margin-bottom: var(--space-8);
    max-width: 560px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .hero__divider {
    width: 100%;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.1);
    margin: var(--space-10) 0;
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-8);
  }

  .hero__stat-value {
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: 600;
    color: var(--color-text-inverse);
    line-height: 1;
    margin-bottom: var(--space-2);
  }

  .hero__stat-label {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #78909C;
  }

  /* Animations */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .anim-fade-up {
      opacity: 0;
      animation: fadeUp 0.6s ease-out forwards;
    }

    .anim-delay-1 { animation-delay: 0.1s; }
    .anim-delay-2 { animation-delay: 0.3s; }
    .anim-delay-3 { animation-delay: 0.5s; }
    .anim-delay-stat-1 { animation-delay: 0.7s; }
    .anim-delay-stat-2 { animation-delay: 0.85s; }
    .anim-delay-stat-3 { animation-delay: 1.0s; }
    .anim-delay-stat-4 { animation-delay: 1.15s; }

    .hero__watermark {
      opacity: 0;
      animation: fadeIn 1.5s ease-out 0.5s forwards;
    }
  }

  @media (max-width: 640px) {
    .hero__br {
      display: none;
    }

    .hero__stats {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }

    .hero__watermark {
      width: 200px;
      right: -60px;
    }
  }

  /* Services CTA */
  .services-cta {
    text-align: center;
    margin-top: var(--space-10);
  }

  /* Why Cards */
  .why-card {
    padding: var(--space-6);
  }

  .why-card__title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .why-card__text {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    margin-bottom: var(--space-4);
  }

  .why-card__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .why-card__list li {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    padding-left: var(--space-4);
    position: relative;
  }

  .why-card__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 6px;
    height: 6px;
    background-color: var(--color-warm);
  }

  .why-card__cert-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .why-card__cert {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--space-1) var(--space-3);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-primary);
  }

  /* Industries */
  .industries-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  .industry-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-4);
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .industry-badge:hover {
    border-color: var(--color-primary);
    background-color: var(--color-bg-alt);
  }

  .industry-badge__icon {
    color: var(--color-primary);
    line-height: 1;
  }

  .industry-badge__name {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text);
    text-align: center;
  }

  @media (max-width: 1024px) {
    .industries-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero__actions .btn {
      text-align: center;
    }

    .industries-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Testimonials Carousel */
  .testimonials-carousel {
    text-align: center;
  }

  .section-heading--light::before {
    background-color: var(--color-warm);
    margin-left: auto;
    margin-right: auto;
  }

  .section-heading--light .section-heading__title {
    color: var(--color-text-inverse);
  }

  .carousel {
    max-width: 780px;
    margin: 0 auto;
  }

  .carousel__quote {
    min-height: 160px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    transition: opacity 0.3s ease;
  }

  .carousel__quote.is-fading {
    opacity: 0;
  }

  .carousel__text {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--color-text-inverse);
    line-height: 1.65;
    margin-bottom: var(--space-6);
    position: relative;
  }

  .carousel__text::before {
    content: '\201C';
    color: var(--color-warm);
    font-size: 3rem;
    line-height: 0;
    vertical-align: -0.35em;
    margin-right: var(--space-1);
    font-weight: 700;
  }

  .carousel__cite {
    font-style: normal;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #78909C;
  }

  .carousel__dots {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-10);
  }

  .carousel__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.25);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.2s;
  }

  .carousel__dot--active {
    background-color: var(--color-warm);
  }

  .carousel__cta {
    margin-top: var(--space-10);
  }

  @media (max-width: 640px) {
    .carousel__text {
      font-size: var(--text-lg);
    }

    .carousel__quote {
      min-height: 200px;
    }
  }
</style>

<script>
  const quotes = [
    {
      text: "Thank you for all of your help — your team is the best. I don't know if I've said that enough recently, but I truly appreciate everything you've done for me with my projects. My success is built on the incredible work your team does, and I make a point of telling Ricoh management that at every opportunity.",
      role: "Senior Project Manager",
    },
    {
      text: "They spent quite a bit of time talking about how much they appreciated your team's hospitality during last month's visit, as well as your business model. Thank you as always for your partnership — and for making us all better in the eyes of our shared customers.",
      role: "Chief Sales Officer",
    },
    {
      text: "Perfect record on the week. It's getting to the point where I almost want to see an error — but in all seriousness, great work. This team is the gold standard of the quality-first mentality, and I really appreciate everyone staying focused on what matters most.",
      role: "Operations Manager",
    },
    {
      text: "There's no way I could be successful in my role without your team's incredible efforts. Thank you so much.",
      role: "Operations Manager",
    },
  ];

  const textEl = document.getElementById('carouselText');
  const citeEl = document.getElementById('carouselCite');
  const dotsEl = document.getElementById('carouselDots');
  const quoteEl = document.querySelector('.carousel__quote');

  let current = 0;
  let timer = null;

  function show(idx) {
    quoteEl.classList.add('is-fading');
    setTimeout(() => {
      textEl.textContent = quotes[idx].text;
      citeEl.textContent = quotes[idx].role;
      dotsEl.querySelectorAll('.carousel__dot').forEach((d, i) => {
        d.classList.toggle('carousel__dot--active', i === idx);
        d.setAttribute('aria-selected', String(i === idx));
      });
      quoteEl.classList.remove('is-fading');
      current = idx;
    }, 300);
  }

  function advance() {
    show((current + 1) % quotes.length);
  }

  function start() {
    timer = setInterval(advance, 6000);
  }

  function stop() {
    if (timer) clearInterval(timer);
  }

  // Build dots
  quotes.forEach((_, i) => {
    const dot = document.createElement('button');
    dot.className = 'carousel__dot' + (i === 0 ? ' carousel__dot--active' : '');
    dot.setAttribute('role', 'tab');
    dot.setAttribute('aria-label', 'Testimonial ' + (i + 1));
    dot.setAttribute('aria-selected', String(i === 0));
    dot.addEventListener('click', () => { stop(); show(i); start(); });
    dotsEl.appendChild(dot);
  });

  // Seed first quote
  textEl.textContent = quotes[0].text;
  citeEl.textContent = quotes[0].role;

  // Auto-advance, pause on hover, respect prefers-reduced-motion
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    quoteEl.addEventListener('mouseenter', stop);
    quoteEl.addEventListener('mouseleave', start);
    start();
  }
</script>
