---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';

const industries = [
  {
    id: 'oil-energy',
    name: 'Oil & Energy',
    description: 'Supporting the oil and energy sector with document management for regulatory compliance, environmental litigation, and contractual obligations across complex multi-party operations.',
    projects: [
      'Regulatory compliance documentation',
      'Environmental litigation support',
      'Joint operating agreement management',
      'Safety and incident report processing',
    ],
    certifications: ['ISO 27001', 'SSAE18 SOC 2'],
  },
  {
    id: 'financial-services',
    name: 'Financial Services',
    description: 'Serving financial institutions with contracts management, regulatory filings, and compliance documentation. Our SOC 2 and PCI-DSS certifications ensure secure handling of sensitive financial data.',
    projects: [
      'Contracts management and abstraction',
      'Regulatory filing support',
      'Compliance documentation review',
      'Financial litigation support',
    ],
    certifications: ['SSAE18 SOC 2', 'PCI-DSS', 'ISAE 3402'],
  },
  {
    id: 'healthcare',
    name: 'Healthcare',
    description: 'HIPAA-compliant document processing for healthcare organizations. From medical records coding to insurance claims processing, we handle protected health information with the highest security standards.',
    projects: [
      'Medical records coding and review',
      'Insurance claims processing (CMS 1450/1500)',
      'HIPAA-compliant document management',
      'Clinical trial documentation support',
    ],
    certifications: ['HIPAA', 'ISO 27001', 'SSAE18 SOC 2'],
  },
  {
    id: 'telecom',
    name: 'Telecom',
    description: 'Supporting telecommunications companies with high-volume document processing for regulatory filings, contracts, and customer documentation across complex multi-state operations.',
    projects: [
      'Regulatory filing documentation',
      'Service agreement management',
      'Billing documentation processing',
      'Compliance audit support',
    ],
    certifications: ['ISO 27001', 'SSAE18 SOC 2'],
  },
  {
    id: 'automobile',
    name: 'Automobile',
    description: 'Document management services for the automotive industry covering warranty documentation, regulatory compliance, product liability support, and manufacturing records processing.',
    projects: [
      'Warranty documentation processing',
      'Regulatory compliance records',
      'Product liability litigation support',
      'Supply chain documentation management',
    ],
    certifications: ['ISO 27001', 'SSAE18 SOC 2'],
  },
  {
    id: 'airline',
    name: 'Airline',
    description: 'Supporting airline and aviation companies with regulatory documentation, safety compliance records, and operational document management under strict industry standards.',
    projects: [
      'Regulatory compliance documentation',
      'Safety record management',
      'Operational procedure documentation',
      'Maintenance record processing',
    ],
    certifications: ['ISO 27001', 'SSAE18 SOC 2'],
  },
  {
    id: 'professional-sports',
    name: 'Professional Sports',
    description: 'High-volume case processing and mail processing for leading US athletic associations. We process over 100,000 transcripts annually, handling paper and electronic documents through unified workflows with chain-of-custody protocols and automated classification — reducing turnaround from 7 days to under 48 hours.',
    projects: [
      'Transcript processing and classification',
      'Case processing and mail processing',
      'Document digitization and indexing',
      'Seasonal volume management (4K–20K/month)',
    ],
    certifications: ['ISO 27001', 'SSAE18 SOC 2'],
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Industry-Specific Document Management Services",
  "description": "Legal document management services for Oil & Energy, Financial Services, Healthcare, Telecom, Automobile, and Airline industries.",
  "url": "https://sourcehubindia.com/industries/",
  "provider": {
    "@type": "Organization",
    "name": "Source Hub India Pvt Ltd",
    "url": "https://sourcehubindia.com",
  },
  "areaServed": ["US", "IN", "GB"],
  "serviceType": industries.map(i => `${i.name} Document Management`),
};
---

<BaseLayout
  title="Industries"
  description="Legal document management services for Oil & Energy, Financial Services, Healthcare, Telecom, Automobile, and Airline industries."
  canonicalPath="/industries/"
  schema={schema}
>
  <section class="page-header">
    <div class="container">
      <h1 class="page-header__title">Industries We Serve</h1>
      <p class="page-header__subtitle">
        Preferred litigation support and document management partner for Fortune 500 companies
        across seven key industry verticals.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="industries-list">
        {industries.map((industry, index) => (
          <div id={industry.id} class:list={['industry-item', { 'industry-item--alt': index % 2 === 1 }]}>
            <div class="industry-item__content">
              <h2 class="industry-item__title">{industry.name}</h2>
              <p class="industry-item__desc">{industry.description}</p>
              <div class="industry-item__certs">
                {industry.certifications.map(cert => (
                  <span class="industry-item__cert">{cert}</span>
                ))}
              </div>
            </div>
            <div class="industry-item__projects">
              <h3 class="industry-item__projects-heading">Project Types</h3>
              <ul class="industry-item__projects-list">
                {industry.projects.map(project => (
                  <li>{project}</li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABanner
    heading="Discuss your industry-specific requirements"
    description="Our team has deep domain expertise across all six verticals. Let's talk about your needs."
  />
</BaseLayout>

<style>
  .page-header {
    background-color: var(--color-bg-dark);
    padding: clamp(2.5rem, 6vw, 4rem) 0;
  }

  .page-header__title {
    font-size: var(--text-4xl);
    color: var(--color-text-inverse);
    margin-bottom: var(--space-4);
  }

  .page-header__subtitle {
    font-size: var(--text-lg);
    color: #B0BEC5;
    max-width: 640px;
  }

  .industries-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .industry-item {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-8);
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    background-color: var(--color-bg);
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
  }

  .industry-item__title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
  }

  .industry-item__desc {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }

  .industry-item__certs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .industry-item__cert {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--space-1) var(--space-3);
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    color: var(--color-primary);
  }

  .industry-item__projects-heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-light);
    margin-bottom: var(--space-3);
  }

  .industry-item__projects-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .industry-item__projects-list li {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    padding-left: var(--space-4);
    position: relative;
  }

  .industry-item__projects-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 6px;
    height: 6px;
    background-color: var(--color-warm);
  }

  @media (max-width: 640px) {
    .industry-item {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      padding: var(--space-6);
    }
  }
</style>
