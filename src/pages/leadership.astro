---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';

const team = [
  {
    name: 'R S Shanbhag',
    title: 'Founder & Director',
    featured: true,
  },
  {
    name: 'V C Kamath',
    title: 'Chairman',
    featured: true,
  },
  {
    name: 'Sampath Kumar H R',
    title: 'Director',
    featured: false,
  },
  {
    name: 'Anil Shanbhag',
    title: 'Head — Finance & Facilities',
    featured: false,
  },
  {
    name: 'Suresh N',
    title: 'General Manager',
    featured: false,
  },
  {
    name: 'Rajesh V',
    title: 'Assistant General Manager',
    featured: false,
  },
  {
    name: 'Shakila S',
    title: 'Senior Project Manager',
    featured: false,
  },
];
---

<BaseLayout
  title="Leadership"
  description="Meet the leadership team of Source Hub India, a 20+ year legal document management company serving Fortune 500 clients."
  canonicalPath="/leadership/"
>
  <section class="page-header">
    <div class="container">
      <h1 class="page-header__title">Leadership</h1>
      <p class="page-header__subtitle">
        Our leadership team brings decades of combined experience in legal process outsourcing,
        document management, and enterprise technology services.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="team-grid">
        {team.map(member => (
          <div class:list={['team-card', { 'team-card--featured': member.featured }]}>
            <div class="team-card__initials">
              {member.name.split(' ').map(n => n[0]).join('').slice(0, 2)}
            </div>
            <h2 class="team-card__name">{member.name}</h2>
            <p class="team-card__title">{member.title}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-heading">
        <h2 class="section-heading__title">An Associate of Value Point Group</h2>
        <p class="section-heading__subtitle">
          Source Hub India is backed by the Value Point Group, a global IT services company
          with over $100 million in revenue and operations across India and internationally.
        </p>
      </div>
      <div class="grid grid--3">
        <div class="vp-stat">
          <div class="vp-stat__value">$100M+</div>
          <div class="vp-stat__label">Group Revenue</div>
        </div>
        <div class="vp-stat">
          <div class="vp-stat__value">20+</div>
          <div class="vp-stat__label">Years in Business</div>
        </div>
        <div class="vp-stat">
          <div class="vp-stat__value">Global</div>
          <div class="vp-stat__label">Presence</div>
        </div>
      </div>
    </div>
  </section>

  <CTABanner
    heading="Get in touch with our team"
    description="We're ready to discuss how Source Hub can support your organization."
  />
</BaseLayout>

<style>
  .page-header {
    background-color: var(--color-bg-dark);
    padding: var(--space-16) 0;
  }

  .page-header__title {
    font-size: var(--text-4xl);
    color: var(--color-text-inverse);
    margin-bottom: var(--space-4);
  }

  .page-header__subtitle {
    font-size: var(--text-lg);
    color: #B0BEC5;
    max-width: 640px;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .team-card {
    padding: var(--space-8) var(--space-6);
    border: 1px solid var(--color-border);
    text-align: center;
  }

  .team-card--featured {
    border-color: var(--color-primary);
    border-width: 2px;
  }

  .team-card__initials {
    width: 64px;
    height: 64px;
    margin: 0 auto var(--space-4);
    background-color: var(--color-bg-dark);
    color: var(--color-text-inverse);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  .team-card--featured .team-card__initials {
    background-color: var(--color-primary);
  }

  .team-card__name {
    font-size: var(--text-lg);
    margin-bottom: var(--space-1);
  }

  .team-card__title {
    font-size: var(--text-sm);
    color: var(--color-text-light);
  }

  /* Value Point Stats */
  .vp-stat {
    text-align: center;
    padding: var(--space-6);
  }

  .vp-stat__value {
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: 600;
    color: var(--color-primary-dark);
    margin-bottom: var(--space-2);
  }

  .vp-stat__label {
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-light);
  }

  @media (max-width: 1024px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
