---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';

const team = [
  {
    name: 'R S Shanbhag',
    title: 'Founder & Director',
    photo: '/images/team/rs-shanbhag.jpg',
    featured: true,
  },
  {
    name: 'V C Kamath',
    title: 'Chairman',
    photo: '/images/team/vc-kamath.jpg',
    featured: true,
  },
  {
    name: 'Sampath Kumar H R',
    title: 'Director',
    photo: '/images/team/sampath-kumar.jpg',
    featured: false,
  },
  {
    name: 'Anil Shanbhag',
    title: 'Head — Finance & Facilities',
    photo: '/images/team/anil-shanbhag.jpg',
    featured: false,
  },
  {
    name: 'Suresh N',
    title: 'General Manager',
    photo: '/images/team/suresh-n.jpg',
    featured: false,
  },
  {
    name: 'Rajesh V',
    title: 'Assistant General Manager',
    photo: '/images/team/rajesh-v.jpg',
    featured: false,
  },
  {
    name: 'Shakila S',
    title: 'Senior Project Manager',
    photo: '/images/team/shakila-s.jpg',
    featured: false,
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Leadership — Source Hub India",
  "url": "https://sourcehubindia.com/leadership/",
  "description": "Meet the leadership team of Source Hub India, a 20+ year legal document management company serving Fortune 500 clients.",
  "mainEntity": {
    "@type": "Organization",
    "@id": "https://sourcehubindia.com/#organization",
    "member": team.map(member => ({
      "@type": "Person",
      "name": member.name,
      "jobTitle": member.title,
    })),
  },
};
---

<BaseLayout
  title="Leadership"
  description="Meet the leadership team of Source Hub India, a 20+ year legal document management company serving Fortune 500 clients."
  canonicalPath="/leadership/"
  schema={schema}
>
  <section class="page-header">
    <div class="container">
      <h1 class="page-header__title">Leadership</h1>
      <p class="page-header__subtitle">
        Our leadership team brings decades of combined experience in legal process outsourcing,
        document management, and enterprise technology services.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="team-grid">
        {team.map(member => (
          <div class:list={['team-card', { 'team-card--featured': member.featured }]}>
            <img src={member.photo} alt={member.name} class="team-card__photo" width="152" height="200" loading="lazy" />
            <h2 class="team-card__name">{member.name}</h2>
            <p class="team-card__title">{member.title}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABanner
    heading="Get in touch with our team"
    description="We're ready to discuss how Source Hub can support your organization."
  />
</BaseLayout>

<style>
  .page-header {
    background-color: var(--color-bg-dark);
    padding: clamp(2.5rem, 6vw, 4rem) 0;
  }

  .page-header__title {
    font-size: var(--text-4xl);
    color: var(--color-text-inverse);
    margin-bottom: var(--space-4);
  }

  .page-header__subtitle {
    font-size: var(--text-lg);
    color: #B0BEC5;
    max-width: 640px;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .team-card {
    padding: var(--space-8) var(--space-6);
    border: 1px solid var(--color-border);
    text-align: center;
  }

  .team-card--featured {
    border-color: var(--color-primary);
    border-width: 2px;
  }

  .team-card__photo {
    width: 120px;
    height: 120px;
    margin: 0 auto var(--space-4);
    border-radius: 50%;
    object-fit: cover;
    object-position: top;
    background-color: var(--color-bg-alt);
  }

  .team-card__name {
    font-size: var(--text-lg);
    margin-bottom: var(--space-1);
  }

  .team-card__title {
    font-size: var(--text-sm);
    color: var(--color-text-light);
  }

  @media (max-width: 1024px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
