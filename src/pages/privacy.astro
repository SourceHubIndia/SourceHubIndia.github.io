---
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Privacy Policy — Source Hub India",
  "url": "https://sourcehubindia.com/privacy/",
  "description": "Privacy policy for Source Hub India Pvt Ltd. Learn how we collect, use, and protect your information.",
  "mainEntity": { "@id": "https://sourcehubindia.com/#organization" },
};
---

<BaseLayout
  title="Privacy Policy"
  description="Privacy policy for Source Hub India Pvt Ltd. Learn how we collect, use, and protect your information."
  canonicalPath="/privacy/"
  schema={schema}
>
  <section class="page-header">
    <div class="container">
      <h1 class="page-header__title">Privacy Policy</h1>
      <p class="page-header__subtitle">
        How we collect, use, and protect your information.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container privacy-content">
      <p class="privacy-updated">Last updated: May 2026</p>

      <h2>Introduction</h2>
      <p>
        Source Hub India Pvt Ltd ("Source Hub," "we," "our," or "us") is committed to protecting
        your privacy. This Privacy Policy explains how we collect, use, disclose, and safeguard
        your information when you visit our website sourcehubindia.com.
      </p>

      <h2>Information We Collect</h2>
      <p>We may collect information about you in the following ways:</p>
      <h3>Information You Provide</h3>
      <p>
        When you contact us via email or phone, we collect the information you voluntarily provide,
        such as your name, email address, phone number, company name, and any message content.
      </p>
      <h3>Automatically Collected Information</h3>
      <p>
        When you visit our website, we may automatically collect certain information about your
        device and usage, including your IP address, browser type, operating system, referring URLs,
        and pages visited. This information is collected through standard web server logs.
      </p>

      <h2>How We Use Your Information</h2>
      <p>We use the information we collect to:</p>
      <ul>
        <li>Respond to your inquiries and provide requested services</li>
        <li>Improve our website and services</li>
        <li>Comply with legal obligations</li>
        <li>Protect against fraudulent or unauthorized activity</li>
      </ul>

      <h2>Data Security</h2>
      <p>
        We implement appropriate technical and organizational security measures to protect your
        information. As an ISO 27001:2022 certified, HIPAA-compliant, and SOC 2 audited organization,
        we maintain rigorous security controls across all our operations.
      </p>

      <h2>Third-Party Services</h2>
      <p>
        Our website may contain links to third-party websites. We are not responsible for the privacy
        practices of these external sites. We encourage you to review the privacy policies of any
        third-party sites you visit.
      </p>

      <h2>Cookies</h2>
      <p>
        Our website uses minimal cookies necessary for basic functionality. We do not use tracking
        cookies or third-party advertising cookies.
      </p>

      <h2>Data Retention</h2>
      <p>
        We retain your information only for as long as necessary to fulfill the purposes for which
        it was collected, or as required by applicable laws and regulations.
      </p>

      <h2>Your Rights</h2>
      <p>
        Depending on your jurisdiction, you may have rights regarding your personal information,
        including the right to access, correct, or delete your data. To exercise these rights,
        please contact us using the information below.
      </p>

      <h2>Changes to This Policy</h2>
      <p>
        We may update this Privacy Policy from time to time. Any changes will be posted on this page
        with an updated revision date.
      </p>

      <h2>Contact Us</h2>
      <p>
        If you have questions about this Privacy Policy or our data practices, please contact us:
      </p>
      <ul>
        <li>Email: <a href="mailto:info@sourcehubindia.com">info@sourcehubindia.com</a></li>
        <li>Phone: <a href="tel:+918041138190">+91-80-4113 8190</a></li>
        <li>
          Address: Source Hub India Pvt Ltd, #29, Shree Krishna, 3rd Floor, Magadi Main Road,
          Govindraj Nagar, Bangalore — 560 040, India
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    background-color: var(--color-bg-dark);
    padding: var(--space-16) 0;
  }

  .page-header__title {
    font-size: var(--text-4xl);
    color: var(--color-text-inverse);
    margin-bottom: var(--space-4);
  }

  .page-header__subtitle {
    font-size: var(--text-lg);
    color: #B0BEC5;
  }

  .privacy-content {
    max-width: 800px;
  }

  .privacy-updated {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .privacy-content h2 {
    font-size: var(--text-2xl);
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
  }

  .privacy-content h3 {
    font-size: var(--text-lg);
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
  }

  .privacy-content p {
    color: var(--color-text-light);
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }

  .privacy-content ul {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
  }

  .privacy-content li {
    color: var(--color-text-light);
    line-height: 1.7;
    margin-bottom: var(--space-2);
    position: relative;
    padding-left: var(--space-4);
  }

  .privacy-content li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    width: 6px;
    height: 6px;
    background-color: var(--color-warm);
  }

  .privacy-content a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .privacy-content a:hover {
    color: var(--color-accent);
  }
</style>
